# Example .wt.toml for a project using `wt`.
#
# This file belongs to the project and is committed to Git. It is read from
# the PRIMARY/main worktree and therefore is shared by all linked worktrees.
# Do not put machine-specific absolute paths here.
#
# To create one in your project, copy this file to <main-worktree>/.wt.toml
# and adjust. You can also generate values with `wt config set`.

main_branch = "develop"

[worktree]
# Directory containing agent worktrees. Relative paths resolve against the
# main worktree root.
base = "../worktrees"
# Target directory name; placeholders: ${project_name}, ${slot}
pattern = "${project_name}-${slot}"

[branch]
# Default branch created by `wt add <slot>` when no branch is given.
# Placeholders: ${slot}, ${project_name}
pattern = "workspace/${slot}"

[merge]
# Merge strategy: no-ff or ff-only
strategy = "no-ff"
# Remote used for fetch/push on `wt merge`
remote = "origin"
# Whether `wt merge` pushes the main branch after a successful merge
push = true
# How many commit subjects from the merged branch are embedded in the no-ff
# merge message (git merge --log=N). Keeps the merge commit self-describing
# so `git log` / agents can see what the merge folded in. 0 or false disables.
log = 20

[commit]
# Coding agent used by `wt commit` when no message is given: pi | claude.
# Empty = auto-detect (pi preferred, then claude).
agent = ""
# Model override passed to the agent (pi: provider/id, e.g. ce/deepseek-v3.2-671b;
# claude: model name). Empty = agent default.
model = ""
# Whether `wt commit` pushes the current branch after a successful commit
# (default false; only explicit --push or this setting enables pushing).
push = false

[hooks]
# Lifecycle hooks. Paths are relative to the main project root. Both run with
# the worktree as cwd and receive WT_MAIN_WORKTREE, WT_WORKTREE, WT_SLOT,
# WT_BRANCH, WT_PROJECT_NAME, WT_MODE (slot|task) and WT_HOOK (setup|teardown).
# `setup` runs after a worktree is created; `teardown` runs before it is
# removed. hooks.post_setup is the legacy name for `setup`.
# setup    = "scripts/setup-worktree.sh"
# teardown = "scripts/teardown-worktree.sh"
# `wt init --scaffold-hooks` writes a generic scripts/wt/hooks.sh and wires
# both of these to it (plus a scripts/wt/extra.sh escape hatch).

[task]
# Task-mode worktrees (ephemeral, one per task) use these settings.
# Branch template. Must contain ${slug}; ${type} is optional.
branch_pattern = "${type}/${slug}"
# Allowed ${type} values (first is the default).
types = ["task"]
# Fallback "lo-hi" TCP range for roles not listed in [task.port_ranges];
# omitted roles otherwise fall back to it, or are unclaimable if it is absent.
# port_range_default = "10000-11000"
# Roles every new claim must carry a port for.
# required_roles = ["gateway", "web"]
# Paths snapshotted by `wt teardown` / `wt archive`.
# archive_paths = ["apps/gateway/data", "logs"]
# archive_budget = 60
# archive_max_bytes = 26214400

#[task.port_ranges]
# Role(app name) -> closed "lo-hi" TCP range. Any number of roles.
# gateway = "10000-10200"
# web = "10201-10400"

# Optional declarative env plane (`wt env materialize|show|get|copy`). wt
# implements a file chain plus a small placeholder language (${slug},
# ${port.<role>}, ${env.<KEY>}, and the db forms ${db_name} /
# ${db.<name>.<field>}) and never project-specific dotenv semantics.
#[env.gateway]
# dir          = "apps/gateway"
# db           = "default"              # bind to a [[db]] for ${db_name}
# files        = [".env", ".env.development", ".env.development.local"]
# seed         = "scripts/seed/gateway.env"   # read from the main worktree
# seed_target  = ".env.development"           # where the seed is written
# gen          = ".env.development.local"     # where values are written
# copy_from_main = [".env.development", ".env.development.local"]
#[env.gateway.values]
# PORT = "${port.gateway}"

# Optional declarative health probes (`wt check`).
#[[check]]
# name   = "api"
# url    = "http://localhost:${port.gateway}/api/v1/models"
# expect = 200
#[[check]]
# name     = "database"
# file     = "apps/gateway/data/gateway.${slug}.sqlite"
# nonempty = true

# Optional declarative database lifecycle (`wt db`). A [[db]] block declares
# shell command lines; wt owns lifecycle ordering, ${slug}/${db_name}/${archive}
# substitution, idempotent create, existence/version probes, the
# only-drop-our-own-name guard, and best-effort teardown. No SQL lives in wt.
# One block per resource; --name selects one (default name: "default").
#
# Placeholders: ${slug}, ${db_slug} (identifier-safe), ${db_name}, ${archive},
# ${port.<role>}, ${env.<KEY>}, ${db.<name>.<field>}.
#
# Create is idempotent (wt probes existence first). Drop runs only when the
# resolved name is proven to be this worktree's own: db_name must contain
# ${slug} or ${db_slug}, every drop command line must reference ${db_name} or
# ${db_slug} (or $WT_DB_NAME/$WT_DB_SLUG), and the main worktree never drops.
# `migrate` is optional and project-owned unless it is truly lifecycle-tied.
#
# Postgres, one database per worktree, using client tools:
#[[db]]
# name    = "default"
# dialect = "postgres"
# scope   = "database"                 # database | schema
# db_name = "loom_${db_slug}"
# url     = "postgresql://localhost:5432/${db_name}"
# create  = ["createdb ${db_name}"]
# migrate = []                        # empty = project-owned (no-op)
# backup  = ["pg_dump -Fc -f ${archive}/${db_name}.dump ${db_name}"]
# drop    = ["psql postgres -qc \"SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${db_name}'\"", "dropdb --if-exists ${db_name}"]
#
# Postgres, one schema per worktree in a shared database (when the dev account
# cannot CREATE/DROP DATABASE):
#[[db]]
# name     = "default"
# dialect  = "postgres"
# scope    = "schema"
# database = "loom"                   # the shared database to connect to
# db_name  = "loom_${db_slug}"         # the per-worktree schema
# create   = ["psql loom -qc 'CREATE SCHEMA IF NOT EXISTS ${db_name}'"]
# drop     = ["psql loom -qc 'DROP SCHEMA IF EXISTS ${db_name} CASCADE'"]
#
# SQLite (keeps the R1 file-based shape):
#[[db]]
# name    = "default"
# dialect = "sqlite"
# db_name = "data/loom.${slug}.sqlite"
# create  = ["mkdir -p data && touch ${db_name}"]
# drop    = ["rm -f ${db_name}"]
